<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="添加商品"
        android:textColor="@color/chat_assistant_text"
        android:textSize="18sp"
        android:letterSpacing="0.04"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etProductTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="商品名称 *"
        android:textSize="14sp"
        android:textColor="@color/chat_assistant_text"
        android:textColorHint="@color/chat_hint"
        android:background="@drawable/bg_chip_leo"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etProductBrand"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="品牌"
        android:textSize="14sp"
        android:textColor="@color/chat_assistant_text"
        android:textColorHint="@color/chat_hint"
        android:background="@drawable/bg_chip_leo"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/etProductPrice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="价格 *"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:textColor="@color/chat_assistant_text"
            android:textColorHint="@color/chat_hint"
            android:background="@drawable/bg_chip_leo"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etProductCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="类目（如 数码电子）"
            android:textSize="14sp"
            android:textColor="@color/chat_assistant_text"
            android:textColorHint="@color/chat_hint"
            android:background="@drawable/bg_chip_leo"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etProductSold"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="销量"
        android:inputType="number"
        android:textSize="14sp"
        android:textColor="@color/chat_assistant_text"
        android:textColorHint="@color/chat_hint"
        android:background="@drawable/bg_chip_leo"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etProductDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="推荐理由 / 描述"
        android:minHeight="80dp"
        android:gravity="top"
        android:textSize="14sp"
        android:textColor="@color/chat_assistant_text"
        android:textColorHint="@color/chat_hint"
        android:background="@drawable/bg_chip_leo"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSubmitProduct"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="提交（暂不可用）"
        android:textColor="@color/chat_bg"
        android:textSize="14sp"
        android:letterSpacing="0.04"
        android:backgroundTint="@color/chat_assistant_text" />

</LinearLayout>
