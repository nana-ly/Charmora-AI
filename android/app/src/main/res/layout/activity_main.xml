<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 主界面 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_bg"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <!-- 顶栏：汉堡菜单 + 名称状态 + 新对话按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="历史记录"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/chat_assistant_text" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_bubble_user" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="绮饰集 · AI 选购"
                    android:textColor="@color/chat_assistant_text"
                    android:textSize="16sp"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选购、比较、加购与结算确认"
                    android:textColor="@color/chat_hint"
                    android:textSize="11sp"
                    android:letterSpacing="0.02"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNewChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="新对话"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/chat_assistant_text" />
        </LinearLayout>

        <!-- 分界线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/leo_border"
            android:layout_marginHorizontal="16dp" />

        <!-- 对话列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <!-- 快捷示例 -->
        <HorizontalScrollView
            android:id="@+id/hsvExamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@android:color/transparent"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupExamples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExample1"
                    style="@style/Leo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 元内送同学的小礼物" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExample2"
                    style="@style/Leo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="帮我搭一套通勤饰品" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExample3"
                    style="@style/Leo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="宿舍桌面怎么收纳" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExample4"
                    style="@style/Leo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="比较这两款挂件" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 底部输入栏（原始结构 + Leo 配色） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_bubble_assistant"
            android:elevation="0dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="start|top"
                android:hint="说点什么..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="52dp"
                android:letterSpacing="0.01"
                android:textColor="@color/chat_assistant_text"
                android:textColorHint="@color/chat_hint"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="语音输入"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/chat_hint"
                app:layout_constraintStart_toStartOf="@id/etMessage"
                app:layout_constraintBottom_toBottomOf="@id/etMessage" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="发送"
                android:src="@android:drawable/ic_menu_send"
                android:tint="@color/chat_assistant_text"
                app:layout_constraintBottom_toBottomOf="@id/etMessage"
                app:layout_constraintEnd_toStartOf="@id/btnPlus" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多功能"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/chat_hint"
                app:layout_constraintEnd_toEndOf="@id/etMessage"
                app:layout_constraintBottom_toBottomOf="@id/etMessage" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 功能面板（默认隐藏） -->
        <LinearLayout
            android:id="@+id/llFunctionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_assistant"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/llAlbum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:tint="@color/chat_assistant_text"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="相册"
                        android:textSize="12sp"
                        android:letterSpacing="0.02"
                        android:textColor="@color/chat_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCamera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="@color/chat_assistant_text"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拍照"
                        android:textSize="12sp"
                        android:letterSpacing="0.02"
                        android:textColor="@color/chat_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:tint="@color/chat_assistant_text"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="购物车"
                        android:textSize="12sp"
                        android:letterSpacing="0.02"
                        android:textColor="@color/chat_hint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/chatBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/chat_assistant_bubble"
            app:itemIconTint="@color/charmora_rose"
            app:itemTextColor="@color/charmora_rose"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_storefront_bottom" />
    </LinearLayout>

    <!-- 侧边栏：对话历史 -->
    <LinearLayout
        android:id="@+id/drawerHistory"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/chat_bg"
        android:orientation="vertical">

        <include layout="@layout/drawer_history_header" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/leo_border" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/leo_border" />

        <TextView
            android:id="@+id/tvClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="清空历史记录"
            android:textColor="@color/chat_hint"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/leo_border" />

        <TextView
            android:id="@+id/tvSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="设置"
            android:textColor="@color/chat_hint"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
