<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_assistant_bubble"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStoreTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="绮饰集 Charmora"
                    android:textColor="@color/chat_assistant_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="正在检查服务连接…"
                    android:textColor="@color/chat_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnStoreSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="服务设置"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/charmora_rose" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStoreSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="AI 陪你完成选购、比较、加购与结算"
            android:textColor="@color/chat_hint"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <EditText
                android:id="@+id/etStoreSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="搜索饰品、小物，或说说你的需求"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/chat_assistant_text"
                android:textColorHint="@color/chat_hint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStoreSearch"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/charmora_rose"
                android:text="搜索"
                android:textColor="@color/chat_bg" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/storeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/storeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/storeProgress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/storeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_assistant_bubble"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconTint="@color/charmora_rose"
        app:itemTextColor="@color/charmora_rose"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_storefront_bottom" />
</LinearLayout>
