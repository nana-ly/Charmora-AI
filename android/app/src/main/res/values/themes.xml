<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Shopguide" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#FFF9FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFF9FB</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#FFF9FB</item>
    </style>

    <!-- Leo 风格 Chip -->
    <style name="Leo.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/chat_assistant_bubble</item>
        <item name="chipStrokeColor">@color/leo_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chat_assistant_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="chipCornerRadius">4dp</item>
        <item name="rippleColor">#22C98FA6</item>
    </style>

    <style name="Theme.Shopguide" parent="Base.Theme.Shopguide" />
</resources>
