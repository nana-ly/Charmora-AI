# 后端基础配置
AGENT_RUNNER=langgraph
RETRIEVER_MODE=vector
DEFAULT_TOP_K=3
LOG_LEVEL=INFO

# Agent 编排配置。当前仅支持 LangGraph Runner。
CONVERSATION_STORE_MODE=memory
CONVERSATION_STORE_PATH=data/conversations.sqlite3

# 向量检索配置。RETRIEVER_MODE=vector 时 /recommend 会使用 ChromaDB RAG 检索。
embedding_url=https://dashscope.aliyuncs.com/compatible-mode/v1
embedding_api=
embedding_model=text-embedding-v4
embedding_dimensions=1024

# 大模型理由生成配置
# 默认关闭，保证本地最小闭环不依赖外部服务。
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
